# Example environment configuration for Caezelle's Catering Mobile App
# Replace with your backend API host:
# For local Android Emulator: http://10.0.2.2:5000/api
# For local iOS Simulator: http://localhost:5000/api
# For physical phone via Expo Go on Wi-Fi: http://<YOUR_LOCAL_IP>:5000/api
# For production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
