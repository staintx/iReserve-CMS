# Backend REST API Base URL (must end with /api)
# For local development: http://localhost:5000/api
# For production on Vercel: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Socket.IO URL (optional; defaults to VITE_API_BASE_URL origin)
# For local development: http://localhost:5000
# For production on Vercel: https://your-backend-domain.com
VITE_SOCKET_URL=http://localhost:5000

# Cloudflare Turnstile Site Key (Public Key)
# Obtain from Cloudflare Dashboard -> Turnstile
VITE_TURNSTILE_SITE_KEY=